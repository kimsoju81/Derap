{
  "id": "/",
  "name": "Derap — Navigasi Jalan Raya Malaysia",
  "short_name": "Derap",
  "description": "Aplikasi navigasi jalan raya pintar Malaysia berasaskan OpenStreetMap, peta vektor 3D OpenFreeMap, penghalaan OSRM, carian Nominatim, peta luar talian dan sokongan Android Auto.",
  "lang": "ms-MY",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "tabbed",
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "tab_strip": {
    "home_tab": {
      "url": "/"
    },
    "new_tab_button": {
      "url": "/?tab=new"
    }
  },
  "orientation": "any",
  "theme_color": "#020617",
  "background_color": "#020617",
  "categories": [
    "navigation",
    "travel",
    "utilities"
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/assets/aistudio/Screenshot_2026-11-23-03-36-04-789_co.median.android.mbnenep_17522f17.jpg",
      "sizes": "2712x1220",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Paparan navigasi aktif landskap dengan panduan lorong, had laju dan ETA masa nyata"
    },
    {
      "src": "/assets/aistudio/Screenshot_2026-11-23-03-36-41-839_co.median.android.mbnenep_8ab20285.jpg",
      "sizes": "2712x1220",
      "type": "image/jpeg",
      "form_factor": "wide",
      "label": "Pratonton laluan alternatif, pilihan bebas tol dan mod kenderaan Malaysia"
    },
    {
      "src": "/assets/aistudio/Screenshot_2026-11-23-03-36-08-257_co.median.android.mbnenep_4cda8eb2.jpg",
      "sizes": "1220x2712",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Navigasi belokan demi belokan mudah alih dengan lencana nombor jalan Malaysia"
    },
    {
      "src": "/assets/aistudio/Screenshot_2026-11-23-11-57-38-731_co.median.android.mbnenep_8e28fae3.jpg",
      "sizes": "1220x2712",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Carian lokasi pintar, alamat tersimpan Rumah & Kerja serta kategori POI pantas"
    }
  ],
  "scope_extensions": [
    {
      "type": "origin",
      "origin": "https://derap.my"
    },
    {
      "type": "origin",
      "origin": "https://maps.derap.my"
    },
    {
      "type": "origin",
      "origin": "https://auth.derap.my"
    },
    {
      "type": "origin",
      "origin": "https://derapmy.blogspot.com"
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://github.com/kimsoju81/derap/releases",
      "id": "com.derap.navigation"
    },
    {
      "platform": "webapp",
      "url": "https://derap.my/manifest.json"
    }
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "file_handlers": [
    {
      "action": "/?action=open-route-file",
      "name": "Fail Laluan & Titik Hentian Derap",
      "accept": {
        "application/gpx+xml": [
          ".gpx"
        ],
        "application/geo+json": [
          ".geojson"
        ],
        "application/vnd.google-earth.kml+xml": [
          ".kml"
        ]
      },
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "geo",
      "url": "/?geo=%s"
    },
    {
      "protocol": "web+derap",
      "url": "/?derap=%s"
    }
  ],
  "share_target": {
    "action": "/?action=share-target",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "note_taking": {
    "new_note_url": "/?action=new-note"
  },
  "shortcuts": [
    {
      "name": "Cari Destinasi",
      "short_name": "Ke Mana?",
      "description": "Buka carian destinasi dan kiraan laluan pantas Derap",
      "url": "/?action=search",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Nota Perjalanan Baharu",
      "short_name": "Nota Baru",
      "description": "Catat lokasi, koordinat atau nota perjalanan baharu",
      "url": "/?action=new-note",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Peta Luar Talian",
      "short_name": "Peta Offline",
      "description": "Urus muat turun peta daerah Malaysia untuk kegunaan luar talian",
      "url": "/?action=offline-maps",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "widgets": [
    {
      "name": "Derap Navigasi Pantas",
      "short_name": "Derap Nav",
      "tag": "derap-nav-widget",
      "description": "Status navigasi pantas, akses terus ke Rumah/Kerja dan nota perjalanan Derap pada papan widget desktop.",
      "ms_ac_template": "/widgets/derap-nav-widget.json",
      "data": "/widgets/derap-nav-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/assets/aistudio/Screenshot_2026-11-23-03-36-04-789_co.median.android.mbnenep_17522f17.jpg",
          "sizes": "2712x1220",
          "label": "Pratonton Widget Navigasi Derap"
        }
      ],
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "auth": false,
      "update": 900
    }
  ]
}
