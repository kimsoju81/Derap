{
  "id": "/",
  "name": "Derap — Navigasi Jalan Raya Pintar Malaysia",
  "short_name": "Derap",
  "description": "Aplikasi navigasi jalan raya pintar untuk Malaysia dengan panduan lorong tepat, kawalan bulatan pintar, carian POI masa nyata Overpass API, dan sokongan peta luar talian automatik.",
  "start_url": "/",
  "scope": "/",
  "lang": "ms-MY",
  "dir": "ltr",
  "orientation": "any",
  "display": "standalone",
  "display_override": [
    "tabbed",
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "tab_strip": {
    "home_tab": {
      "url": "/",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    "new_tab_button": {
      "url": "/?tab=route"
    }
  },
  "theme_color": "#0088EE",
  "background_color": "#FFFFFF",
  "categories": [
    "navigation",
    "travel",
    "utilities",
    "maps"
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "/manifest.json",
      "id": "my.derap.navigation.pwa"
    },
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=my.derap.navigation",
      "id": "my.derap.navigation"
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://*.openfreemap.org"
    },
    {
      "origin": "https://*.openstreetmap.org"
    },
    {
      "origin": "https://overpass-api.de"
    }
  ],
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/derap-desktop-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Paparan navigasi Derap pada skrin lebar dan lanskap kenderaan"
    },
    {
      "src": "/screenshots/derap-mobile-narrow.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Paparan navigasi Derap pada telefon pintar dengan carian Ke Mana"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "file_handlers": [
    {
      "action": "/?action=open-route",
      "accept": {
        "application/gpx+xml": [".gpx"],
        "application/vnd.google-earth.kml+xml": [".kml"],
        "application/geo+json": [".geojson", ".json"]
      },
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "geo",
      "url": "/?geo=%s"
    },
    {
      "protocol": "web+derap",
      "url": "/?derap=%s"
    }
  ],
  "share_target": {
    "action": "/?action=share-location",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "shared_title",
      "text": "shared_text",
      "url": "shared_url"
    }
  },
  "edge_side_panel": {
    "preferred_width": 420
  },
  "note_taking": {
    "new_note_url": "/?action=new-note"
  },
  "widgets": [
    {
      "name": "Status Navigasi Derap",
      "short_name": "Derap",
      "description": "Pintas terus ke carian destinasi, status peta luar talian, dan cuaca trafik semasa.",
      "tag": "derap-nav-widget",
      "template": "derap-nav-template",
      "ms_ac_template": "/widgets/derap-widget-template.json",
      "data": "/widgets/derap-widget-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshots/derap-desktop-wide.png",
          "sizes": "1280x720",
          "label": "Widget Status Navigasi Derap"
        }
      ],
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "auth": false,
      "update": 3600
    }
  ],
  "shortcuts": [
    {
      "name": "Ke Mana?",
      "short_name": "Ke Mana",
      "description": "Cari destinasi atau hentian baharu dengan segera",
      "url": "/?shortcut=search",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Peta Luar Talian",
      "short_name": "Offline",
      "description": "Urus dan kemas kini data peta luar talian Derap",
      "url": "/?shortcut=offline",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Tetapan Derap",
      "short_name": "Tetapan",
      "description": "Buka tetapan kenderaan, peta, dan navigasi",
      "url": "/?shortcut=settings",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
